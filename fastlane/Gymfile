# gym (build_app) configuration for the `beta` lane. Kept out of the Fastfile so
# the build settings are declarative and reviewable in one place.
#
# The app is a Capacitor shell: `npm run build:native` builds dist/client and
# runs `cap sync ios`, so by the time gym runs the web assets are already inside
# the Xcode project. Signing comes from match (App Store profile for dev.flatfold)
# — see the beta lane in Fastfile.
scheme("App")
# THE WORKSPACE, not the project. This said `project(...)` from the SwiftPM era;
# the Mac Catalyst migration moved the app to CocoaPods, and a pods project only
# links through the workspace. Passing both is a hard fastlane error
# ("You can only pass either a workspace or a project path, not both"), so this
# is the single place it can be set.
workspace("ios/App/App.xcworkspace")
export_method("app-store")
clean(true)
output_directory("build")
output_name("FlatFold")
