<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Catalyst apps run in the macOS App Sandbox, and the iOS entitlements file
	     says nothing about it, so the sandbox keys have to live here.
	     NOTE: adding these did NOT make WebKit expose navigator.mediaDevices —
	     that was the hypothesis, and it was refuted. On a Mac the WebView has no
	     mediaDevices at all, entitlements or not, which is precisely why voice
	     notes are recorded natively (ios/App/App/FlatFoldAudioPlugin.swift).
	     Do not re-add a media entitlement expecting to unlock a web API. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Microphone, for voice notes. Consumed by FlatFoldAudioPlugin (AVAudio),
	     NOT by the WebView — see the note above. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- NO CAMERA ENTITLEMENT, DELIBERATELY. App Review rejected the first macOS
	     build under Guideline 2.4.5(i) for shipping com.apple.security.device.camera
	     with no matching functionality, and they were right: the only camera path
	     is the safety-number QR scanner in SafetyNumberDialog.tsx, which is gated
	     on `navigator.mediaDevices?.getUserMedia` and therefore never renders on a
	     Mac. There is no Capacitor camera plugin and no AVCapture code. QR scanning
	     is unaffected on iOS, where camera access comes from
	     NSCameraUsageDescription rather than a sandbox entitlement. If a Mac camera
	     feature is ever built natively, add the entitlement back in the SAME commit
	     as the feature. -->

	<!-- REQUIRED once sandboxed, and easy to forget: without it every API call
	     and the WebSocket fail, which looks like a broken backend rather than a
	     missing entitlement. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Saving an attachment via the share/save sheet. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
