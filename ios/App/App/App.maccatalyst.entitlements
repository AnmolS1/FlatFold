<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Catalyst apps run in the macOS App Sandbox, and the iOS entitlements file
	     says nothing about it. Without these, WebKit does not expose
	     navigator.mediaDevices at all — which is why the Catalyst build reported
	     the same "no mediaDevices" as the passthrough despite being a real Mac
	     app. Same symptom, genuinely different cause. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- THE ONE THIS IS ALL ABOUT: microphone, for voice notes. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- Camera, for scanning a contact's safety-number QR code. -->
	<key>com.apple.security.device.camera</key>
	<true/>

	<!-- REQUIRED once sandboxed, and easy to forget: without it every API call
	     and the WebSocket fail, which looks like a broken backend rather than a
	     missing entitlement. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Saving an attachment via the share/save sheet. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
