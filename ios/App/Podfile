require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

# Input/output paths are left ENABLED on purpose.
#
# Capacitor's generated Podfile sets `:disable_input_output_paths => true`, and
# that is precisely what makes Xcode warn:
#
#   "[CP] Embed Pods Frameworks will be run during every build because it does
#    not specify any outputs"
#
# Without those paths Xcode cannot do dependency analysis on the script phase, so
# it re-runs the framework embed on every single build. Leaving them on removes
# the warning and the wasted work.

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'AparajitaCapacitorSecureStorage', :path => '../../node_modules/@aparajita/capacitor-secure-storage'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorHaptics', :path => '../../node_modules/@capacitor/haptics'
  pod 'CapacitorKeyboard', :path => '../../node_modules/@capacitor/keyboard'
  pod 'CapacitorLocalNotifications', :path => '../../node_modules/@capacitor/local-notifications'
  pod 'CapacitorPushNotifications', :path => '../../node_modules/@capacitor/push-notifications'
  pod 'CapacitorShare', :path => '../../node_modules/@capacitor/share'
  # @capacitor/filesystem is EXCLUDED for Catalyst, deliberately and explicitly.
  #
  # It depends on IONFilesystemLib, a PREBUILT binary
  # (`vendored_frameworks: IONFilesystemLib.xcframework`) with no maccatalyst
  # slice, so a Catalyst build fails with:
  #
  #   IONFilesystemLib.xcframework: Unable to find matching slice in
  #   'ios-arm64 ios-arm64_x86_64-simulator' ... platform (-maccatalyst)
  #
  # Same root cause as Capacitor's own SwiftPM problem. Capacitor was fixable by
  # building from source; a vendored third-party framework is not.
  #
  # It is used in exactly ONE place — MediaAttachment's native file save — and on
  # Catalyst the real macOS WKWebView should handle `<a download>` directly, so
  # the plugin is probably unnecessary there. Until that is confirmed, this stays
  # an explicit switch rather than a silent omission:
  #
  #   pod install                       # iOS (default) — filesystem INCLUDED
  #   FLATFOLD_CATALYST=1 pod install   # Mac Catalyst  — filesystem EXCLUDED
  unless ENV['FLATFOLD_CATALYST'] == '1'
    pod 'CapacitorFilesystem', :path => '../../node_modules/@capacitor/filesystem'
  end
end

target 'App' do
  capacitor_pods
end

post_install do |installer|
  assertDeploymentTarget(installer)

  # THE POINT OF THIS MIGRATION.
  #
  # SwiftPM ships Capacitor as a prebuilt xcframework with only `ios-arm64` and
  # `ios-arm64_x86_64-simulator` slices, so a Catalyst build cannot link. Pods
  # compile from SOURCE, and that source was measured to typecheck for
  # arm64-apple-ios-macabi with a delta of ZERO against plain iOS across
  # Capacitor core and every plugin. See docs/DESKTOP_SHELL_OPTIONS.md.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['SUPPORTS_MACCATALYST'] = 'YES'
      config.build_settings['DERIVE_MACCATALYST_PRODUCT_BUNDLE_IDENTIFIER'] = 'NO'
    end
  end
end
