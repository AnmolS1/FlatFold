{
	"name": "flatfold",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"description": "A web-first, end-to-end encrypted messenger whose server stores no messages.",
	"license": "AGPL-3.0-only",
	"author": "Anmol Saxena",
	"homepage": "https://flatfold.ponderance.dev",
	"repository": {
		"type": "git",
		"url": "https://github.com/AnmolS1/FlatFold"
	},
	"keywords": [
		"end-to-end-encryption",
		"e2ee",
		"messenger",
		"signal-protocol",
		"double-ratchet",
		"sealed-sender",
		"cloudflare-workers",
		"privacy"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build && node scripts/gen-sw-manifest.mjs",
		"lint": "eslint .",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"cf-typegen": "wrangler types",
		"postinstall": "wrangler types",
		"build:native": "vite build && node scripts/gen-sw-manifest.mjs && node scripts/inject-native-csp.mjs && cap sync ios"
	},
	"dependencies": {
		"@aparajita/capacitor-secure-storage": "^8.0.0",
		"@capacitor/app": "^8.1.1",
		"@capacitor/filesystem": "^8.1.2",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/keyboard": "^8.0.5",
		"@capacitor/local-notifications": "^8.2.1",
		"@capacitor/push-notifications": "^8.1.2",
		"@capacitor/share": "^8.0.1",
		"@hpke/core": "^1.9.0",
		"@noble/ciphers": "^2.2.0",
		"@noble/curves": "^2.2.0",
		"@noble/hashes": "^2.2.0",
		"@scure/base": "^2.2.0",
		"@scure/bip39": "^2.2.0",
		"hash-wasm": "^4.12.0",
		"jsqr": "^1.4.0",
		"lucide-react": "^0.546.0",
		"minisearch": "^7.2.0",
		"qrcode-generator": "^2.0.4",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-router-dom": "^7.9.4",
		"worker-password-auth": "^1.0.0"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.4.2",
		"@capacitor/core": "^8.4.2",
		"@capacitor/ios": "^8.4.2",
		"@cloudflare/vite-plugin": "^1.43.0",
		"@cloudflare/vitest-pool-workers": "^0.18.0",
		"@eslint/js": "^9.36.0",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.6.0",
		"@types/react": "^19.1.16",
		"@types/react-dom": "^19.1.9",
		"@vitejs/plugin-react": "^5.0.4",
		"eslint": "^9.36.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.22",
		"fake-indexeddb": "^6.2.5",
		"globals": "^16.4.0",
		"jsdom": "^29.1.1",
		"tailwindcss": "^4.1.15",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.45.0",
		"vite": "^7.1.7",
		"vitest": "^4.1.9",
		"wrangler": "^4.107.0"
	}
}
